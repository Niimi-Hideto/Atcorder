# AtCoder compiled binaries (拡張子なし: a459, b471, c471, d471, e/f/g... など)
[abcdefg][0-9][0-9][0-9]
# 復習で作り直した版のバイナリ (c449_2, c447_3 など、末尾に _何か が付くもの)
[abcdefg][0-9][0-9][0-9]_*
# 鉄則本の compiled binaries (番号が2桁: a01, b14, c20 など)
[abc][0-9][0-9]
[abc][0-9][0-9]_*

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# 書籍・資料のPDF (著作物なのでリポジトリには上げない)
*.pdf

# local editor/tool settings (contains local paths, not for sharing)
.claude/settings.local.json
.DS_Store
